{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "siab://contracts/store/product.schema.json",
  "title": "product",
  "description": "store.product, id product::<sku>. The venue-facing shape: no cost, supplier or margin, and additionalProperties false forbids them. Written by hq only; routed to catalog:<region>. image and embedding are reserved for Phase 1.",
  "x-id-template": "product::{sku}",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "type", "sku", "name", "price", "category", "category_family", "size", "color", "tags", "regions"],
  "properties": {
    "v": { "const": 1 },
    "type": { "const": "product" },
    "sku": { "$ref": "../common.schema.json#/$defs/sku" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "price": { "$ref": "../common.schema.json#/$defs/money" },
    "category": { "enum": ["jackets", "fleece", "base-layers", "socks", "hats", "packs", "gloves"] },
    "category_family": { "enum": ["outerwear", "layers", "accessories", "bags"] },
    "size": {
      "description": "XS..XXL, OS for one size, or a number (a pack's litres).",
      "type": ["string", "null"],
      "pattern": "^(XS|S|M|L|XL|XXL|OS|[0-9]{1,3})$"
    },
    "color": { "type": ["string", "null"], "minLength": 1, "maxLength": 30 },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "../common.schema.json#/$defs/region" }
    }
  }
}
