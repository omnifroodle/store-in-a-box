# Store in a Box: copy to .env (never committed) and fill in. Names are the contract (docs/workstreams/WS2-capella-sync.md).
# Capella Data Service (SDK): couchbases://... connection string and a cluster database credential.
CAPELLA_CONN_STRING=
CAPELLA_DB_USERNAME=
CAPELLA_DB_PASSWORD=
# Capella Management API v4: bearer token, the API base URL (see Capella's API docs) and the ids it addresses.
CAPELLA_API_KEY=
# The Capella Management API v4 base URL (see Capella's API docs).
CAPELLA_API_BASE=
CAPELLA_ORG_ID=
CAPELLA_PROJECT_ID=
CAPELLA_CLUSTER_ID=
CAPELLA_APP_SERVICE_ID=
# App Services: wss://.../<endpoint> (the box's replication target) and the Admin REST API base, if exposed.
APP_SERVICES_PUBLIC_URL=
APP_SERVICES_ADMIN_URL=
# Defaults for the CLI, e.g. trip-2026-10-18-riverfest and va-central.
SIAB_TRIP=
SIAB_REGION=
# App Services users (names default to box-07 and hq, as in contracts/fixtures/seed/custodians.json).
BOX_APP_USER=
BOX_APP_PASSWORD=
HQ_APP_USER=
HQ_APP_PASSWORD=

# The box (WS3): Couchbase Edge Server and the box agent
EDGE_PORT=59840
# off: the tablets replicate over plain ws:// on the venue LAN (Phase 0); on: wss:// with a self-signed cert
EDGE_TLS=off
EDGE_TABLET_A_PASSWORD=
EDGE_TABLET_B_PASSWORD=
EDGE_PHONE_1_PASSWORD=
SIAB_BOX_PORT=8787
SIAB_PROXY_PORT=8790
SIAB_BOX_ID=box-07

# The HQ app (WS5): loopback port, the box agent's /status for the byte-counter panel (optional), reconcile interval
SIAB_HQ_PORT=8788
SIAB_BOX_STATUS_URL=
SIAB_RECONCILE_INTERVAL_S=3
