# Copy to .env and fill in. Never commit .env.
# WS2 owns the Capella and App Services names (APP_SERVICES_PUBLIC_URL, BOX_APP_USER, BOX_APP_PASSWORD, SIAB_TRIP,
# SIAB_REGION and the rest); this file was started by WS3 with only the box's names below.

# The box (WS3): Couchbase Edge Server and the box agent
EDGE_PORT=59840
# off: the tablets replicate over plain ws:// on the venue LAN (Phase 0); on: wss:// with a self-signed cert
EDGE_TLS=off
EDGE_TABLET_A_PASSWORD=
EDGE_TABLET_B_PASSWORD=
EDGE_PHONE_1_PASSWORD=
SIAB_BOX_PORT=8787
SIAB_PROXY_PORT=8790
SIAB_BOX_ID=box-07
